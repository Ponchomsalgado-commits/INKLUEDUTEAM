#ESTE ARCHIVO ES UN EJEMPLO DE VARIABLES DE ENTORNO PARA EL PROYECTO . NO DEBE SER USADO TAL CUAL EN PRODUCCIÓN. CADA DESARROLLADOR DEBE CREAR SU PROPIO ARCHIVO .env CON SUS VALORES LOCALES.

# === API ===
PORT=3000
NODE_ENV=development

# === PostgreSQL ===
DB_HOST=postgres
DB_PORT=5432
DB_USER=tdah_user
DB_PASSWORD=tdah_pass
DB_NAME=tdah_db

# === MinIO (almacenamiento de archivos, compatible con S3) ===
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass123
MINIO_BUCKET=tdah-media
MINIO_CONSOLE_PORT=9002

# === JWT (se usa a partir del Sprint 1) ===
JWT_SECRET=cambia_este_valor_en_produccion
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d

# === URL del backend para los clientes (web y móvil la usan) ===
API_URL=http://localhost:3000
