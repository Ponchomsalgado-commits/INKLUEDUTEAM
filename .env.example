# Plantilla de variables de entorno. Hay UN solo .env, en la raíz del repo:
#   cp .env.example .env
# Nunca subas el .env real. Si agregas una variable, agrégala también aquí con un valor de ejemplo.
# En servidor: cambia TODAS las contraseñas y secretos (ver docs/DESPLIEGUE.md).

# === API ===
PORT=3000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por comas. Vacío = cualquiera (solo para desarrollo).
# Ejemplo en servidor: CORS_ORIGINS=https://inkluedu.mx
CORS_ORIGINS=

# === PostgreSQL ===
DB_HOST=postgres
DB_PORT=5432
DB_USER=tdah_user
DB_PASSWORD=tdah_pass
DB_NAME=tdah_db

# === Prisma ===
# El host "postgres" solo funciona dentro de Docker.
# Si corres el backend fuera de Docker, cambia "postgres" por "localhost".
DATABASE_URL=postgresql://tdah_user:tdah_pass@postgres:5432/tdah_db

# === JWT ===
# En servidor genera valores largos y aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_valor_access
JWT_REFRESH_SECRET=cambia_este_valor_refresh
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# === MinIO (almacenamiento de archivos compatible con S3; se usará desde el Sprint 3) ===
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass123
MINIO_BUCKET=tdah-media
MINIO_CONSOLE_PORT=9002

# === Web (Vite lee este mismo archivo gracias a envDir: '..' en web/vite.config.js) ===
# Pasa por el proxy de Vite (desarrollo) o de Nginx (servidor) hacia la API
VITE_API_URL=/api/v1

# === Servidor (docker-compose.prod.yml) ===
# Puerto público donde Nginx sirve la web y la API
WEB_PORT=80

# === Móvil ===
# Flutter no lee este archivo; la URL de la API se pasa al ejecutar:
#   flutter run --dart-define=API_URL=http://192.168.X.X:3000
