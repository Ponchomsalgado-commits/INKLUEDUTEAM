meta {
  name: Registro profesor
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "email": "profe@test.local",
    "password": "Prueba123",
    "role": "PROFESOR"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("access_token", res.body.access_token);
    bru.setVar("refresh_token", res.body.refresh_token);
  }
}

docs {
  Crea una cuenta de profesor y guarda los tokens para las demás peticiones.
  Si el correo ya existe responde 409: usa "Login" en su lugar.
}
