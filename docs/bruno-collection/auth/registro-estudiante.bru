meta {
  name: Registro estudiante
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "email": "alumno@test.local",
    "password": "Prueba123",
    "role": "ESTUDIANTE"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("student_token", res.body.access_token);
  }
}

docs {
  Crea una cuenta de estudiante y guarda su access token en student_token (lo usa "Unirse a salón").
}
