{
    "compilerOptions":{
        "module": "commonjs",
        "target": "es2021",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "sourceMap": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "noImplicitAny":true,
        "forceConsistentCasingInFileNames": true,

    }
}