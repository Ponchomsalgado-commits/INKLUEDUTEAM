generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROFESOR
  ESTUDIANTE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  classroomsTaught     Classroom[]       @relation("TeacherClassrooms")
  classroomMemberships ClassroomMember[] @relation("StudentMemberships")
  activities           TeacherActivity[] @relation("TeacherActivities")
  progress             Progress[]
  badges               StudentBadge[]

  @@map("users")
}

enum ClassroomType {
  GRUPO
  INDIVIDUAL
}

model Classroom {
  id          String            @id @default(uuid())
  teacherId   String            @map("teacher_id")
  teacher     User              @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  name        String
  joinCode    String            @unique @map("join_code")
  type        ClassroomType
  createdAt   DateTime          @default(now()) @map("created_at")
  members     ClassroomMember[]
  assignments Assignment[]

  @@map("classrooms")
}

model ClassroomMember {
  classroomId String   @map("classroom_id")
  studentId   String   @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  classroom Classroom @relation(fields: [classroomId], references: [id])
  student   User      @relation("StudentMemberships", fields: [studentId], references: [id])

  @@id([classroomId, studentId])
  @@map("classroom_members")
}

model GameTemplate {
  id          String @id @default(uuid())
  type        String @db.VarChar(40)
  skin        String @db.VarChar(40)
  displayName String @map("display_name") @db.VarChar(80)
  schemaJson  Json   @map("schema_json")

  activities TeacherActivity[]

  @@unique([type, skin])
  @@map("game_templates")
}

model TeacherActivity {
  id             String       @id @default(uuid())
  teacherId      String       @map("teacher_id")
  teacher        User         @relation("TeacherActivities", fields: [teacherId], references: [id])
  templateId     String       @map("template_id")
  template       GameTemplate @relation(fields: [templateId], references: [id])
  title          String       @db.VarChar(150)
  contentJson    Json         @map("content_json")
  // Claves de objeto en MinIO (no URLs públicas); se firman al responder
  mediaUrls      String[]     @default([]) @map("media_urls")
  // Sube cada vez que cambia el contenido o el material (mitigación offline, doc. sección 1.11)
  contentVersion Int          @default(1) @map("content_version")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  progress    Progress[]
  assignments Assignment[]

  @@index([teacherId])
  @@map("teacher_activities")
}

model Progress {
  id              String           @id @default(uuid())
  studentId       String           @map("student_id")
  student         User             @relation(fields: [studentId], references: [id])
  activityId      String           @map("activity_id")
  activity        TeacherActivity  @relation(fields: [activityId], references: [id])
  score           Int
  totalPreguntas  Int              @map("total_preguntas")
  contentVersion  Int              @map("content_version")
  clientAttemptId String?          @map("client_attempt_id")
  submittedAt     DateTime         @default(now()) @map("submitted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  answers         ProgressAnswer[]

  @@unique([studentId, clientAttemptId])
  @@index([activityId])
  @@map("progress")
}

model ProgressAnswer {
  id         String   @id @default(uuid())
  progressId String   @map("progress_id")
  progress   Progress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  preguntaId String   @map("pregunta_id")
  opcionId   Int      @map("opcion_id")
  correcta   Boolean

  @@index([progressId])
  @@map("progress_answers")
}

// Sprint 5: una actividad publicada hacia un salón o tutoría, con fecha límite
model Assignment {
  id          String          @id @default(uuid())
  activityId  String          @map("activity_id")
  activity    TeacherActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  classroomId String          @map("classroom_id")
  classroom   Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  dueDate     DateTime        @map("due_date")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([activityId, classroomId])
  @@index([classroomId])
  @@map("assignments")
}

// Sprint 6: catálogo de insignias (solo positivas) y las que obtuvo cada estudiante
model Badge {
  id          String         @id @default(uuid())
  code        String         @unique @db.VarChar(40)
  name        String         @db.VarChar(80)
  description String
  icon        String         @default("star") @db.VarChar(40)
  awards      StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  studentId   String   @map("student_id")
  student     User     @relation(fields: [studentId], references: [id])
  badgeId     String   @map("badge_id")
  badge       Badge    @relation(fields: [badgeId], references: [id])
  streakCount Int      @default(1) @map("streak_count")
  awardedAt   DateTime @default(now()) @map("awarded_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([studentId, badgeId])
  @@map("student_badges")
}
