


generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROFESOR
  ESTUDIANTE
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         Role
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("users")
}
